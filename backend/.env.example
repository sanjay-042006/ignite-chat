# Environment configuration for backend

# Database Connection (Supabase or other Postgres)
DATABASE_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres"

# Port Selection (usually passed by hosting provider)
PORT=5000

# Environment Type
NODE_ENV="production" # Use 'development' for local

# Security
JWT_SECRET="your-strong-jwt-secret-here"

# Frontend Origin URL (used to restrict CORS, separating by commas if multiple)
# For Vercel, this will look like: https://your-project.vercel.app
CLIENT_URL="http://localhost:5173" 
